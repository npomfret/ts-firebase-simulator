{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch",
      "mcp__gitnexus",
      "mcp__webstorm"
    ],
    "deny": [
      "mcp__webstorm__execute_terminal_command",
      "mcp__webstorm__execute_run_configuration",
      "mcp__webstorm__execute_tool",
      "mcp__webstorm__run_inspection_kts",
      "mcp__webstorm__build_project",
      "mcp__webstorm__apply_patch",
      "mcp__webstorm__create_new_file",
      "mcp__webstorm__reformat_file"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "git ls-remote *",
      "git clone *",
      "ssh *",
      "scp *",
      "rsync *",
      "python3 scripts/teamcity.py *",
      "./scripts/teamcity.py *",
      "npm run tc*"
    ],
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true,
      "allowAllUnixSockets": true
    },
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/Library/pnpm",
        "~/Library/Developer/Xcode/DerivedData",
        "~/.gitnexus",
        "~/.docker/buildx",
        "/var/folders"
      ]
    }
  },
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "task-files@npomfret": true,
    "teamcity@npomfret": true,
    "webstorm@npomfret": true
  },
  "enabledMcpjsonServers": ["gitnexus", "webstorm"]
}
